---
interface Props {
  title: string;
  backHref?: string;
  backLabel?: string;
  description?: string;
}

const { title, backHref = '/', backLabel = 'ホーム', description } = Astro.props;
---

<main class="px-4 pt-8 pb-16 sm:pt-10">
  <div class="mx-auto max-w-3xl">
    {backHref && (
      <a
        href={backHref}
        class="mb-6 inline-flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-foreground"
      >
        <span aria-hidden="true">←</span>
        {backLabel}
      </a>
    )}

    <h1 class="text-3xl font-bold tracking-wide text-foreground">
      {title}
    </h1>

    <slot name="meta" />

    {description && (
      <p class="mt-3 mb-8 max-w-2xl text-muted leading-relaxed">
        {description}
      </p>
    )}

    {!description && <div class="mb-8"></div>}

    <slot />
  </div>
</main>
