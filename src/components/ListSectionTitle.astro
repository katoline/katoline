---
interface Props {
  text: string;
  withDivider?: boolean;
  class?: string;
  id?: string;
  count?: number;
  countSuffix?: string;
}

const {
  text,
  withDivider = false,
  class: extraClass = '',
  id,
  count,
  countSuffix = '件',
} = Astro.props;
---

<div class={extraClass}>
  <h2 id={id} class="text-lg font-bold tracking-wide text-foreground flex items-baseline gap-2">
    {text}
    {count != null && (
      <span class="rounded-full border border-border px-2 py-0.5 text-xs font-normal tracking-normal text-muted">
        {count}{countSuffix}
      </span>
    )}
  </h2>
  {withDivider && <div class="mt-2 h-0.5 w-10 rounded-full bg-accent"></div>}
</div>
