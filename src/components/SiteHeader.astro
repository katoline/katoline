---
import ThemeToggle from './ThemeToggle.astro';
---

<header class="sticky top-0 z-40 bg-background/80 backdrop-blur-xl">
  <div class="px-4">
    <div class="mx-auto flex max-w-3xl items-center justify-between py-3">
      <a
        href="/"
        class="text-[0.95rem] font-bold tracking-wide text-foreground transition-colors hover:text-accent"
      >
        @tonosaki
      </a>
      <!-- ボタンの内側余白ぶん右へ寄せ、アイコンの右端を本文の右端に揃える -->
      <div class="-mr-2">
        <ThemeToggle />
      </div>
    </div>
  </div>
  <div class="rainbow-line" aria-hidden="true"></div>
</header>
