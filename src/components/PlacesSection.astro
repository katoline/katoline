---
import ListSectionTitle from './ListSectionTitle.astro';

export type Place = {
  label: string;
  href?: string;
};

type Area = {
  id: string;
  title?: string;
  places: Place[];
};

interface Props {
  sectionId: string;
  title: string;
  areas: Area[];
  class?: string;
  withDivider?: boolean;
  countSuffix?: string;
}

const {
  sectionId,
  title,
  areas,
  class: extraClass = '',
  withDivider = true,
  countSuffix = '件',
} = Astro.props;

const hasSubAreas = areas.length > 1 || Boolean(areas[0]?.title);
const sectionCount = areas.reduce((n, area) => n + area.places.length, 0);

const rowClass =
  'flex w-full items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-foreground wrap-break-word transition-colors';
---

<section aria-labelledby={sectionId} class={extraClass}>
  <ListSectionTitle
    text={title}
    withDivider={withDivider}
    class="mb-4"
    id={sectionId}
    count={hasSubAreas ? undefined : sectionCount}
    countSuffix={countSuffix}
  />

  {sectionCount === 0 ? (
    <p class="text-sm text-muted">まだありません</p>
  ) : areas.map((area) => {
    const list = (
      <ul class="card divide-y divide-border p-2">
        {area.places.map((place) => {
          const href = place.href?.trim() ?? '';
          const linked = href.length > 0;
          const external = /^https?:\/\//i.test(href);

          return (
            <li>
              {linked ? (
                <a
                  href={href}
                  class:list={[rowClass, 'hover:bg-surface-hover hover:text-accent']}
                  {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                >
                  <span class="min-w-0 wrap-break-word">{place.label}</span>
                  {external && (
                    <span class="shrink-0 text-sm text-subtle" aria-hidden="true">↗</span>
                  )}
                  {external && <span class="sr-only">（新しいタブで開く）</span>}
                </a>
              ) : (
                <div class={rowClass}>
                  <span class="min-w-0 wrap-break-word">{place.label}</span>
                </div>
              )}
            </li>
          );
        })}
      </ul>
    );

    if (!hasSubAreas || !area.title) {
      return list;
    }

    return (
      <section
        aria-labelledby={`area-${area.id}-heading`}
        class="mb-6 last:mb-0"
      >
        <h3
          id={`area-${area.id}-heading`}
          class="mb-2 flex items-baseline gap-2 px-1 text-sm font-bold text-foreground"
        >
          {area.title}
          <span class="rounded-full border border-border px-2 py-0.5 text-xs font-normal text-muted">
            {area.places.length}{countSuffix}
          </span>
        </h3>
        {list}
      </section>
    );
  })}
</section>
