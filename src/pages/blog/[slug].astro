---
import Layout from '../../layouts/Layout.astro';
import ListPageLayout from '../../components/ListPageLayout.astro';
import Details from '../../components/mdx/Details.astro';
import { render } from 'astro:content';
import { getPublishedPosts, type BlogEntry } from '../../lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post: BlogEntry) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

interface Props {
  post: BlogEntry;
}

const { post } = Astro.props;
const { title, date, description } = post.data;
const pageTitle = `${title} - @tonosaki`;
const { Content } = await render(post);
---

<Layout title={pageTitle} description={description ?? title} ogType="article">
  <ListPageLayout
    title={title}
    backHref="/blog"
    backLabel="ブログ"
  >
    {date && (
      <p slot="meta" class="mt-2 text-sm text-muted">
        {date.toLocaleDateString('ja-JP', { timeZone: 'UTC' })}
      </p>
    )}

    <article class="card prose max-w-none p-6 sm:p-8">
      <Content components={{ Details }} />
    </article>
  </ListPageLayout>
</Layout>
