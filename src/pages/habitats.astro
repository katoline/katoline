---

<Layout 
  title="生息地 - @tonosaki"
  description="よくいる場所と、よく行くお店のメモです。ダーツスポットや飲食店の情報をまとめています。どこかで遭遇したら飯でも奢ってやるよ。"
>
  <ListPageLayout
    title="生息地"
    backHref="/"
    description="よくいる場所と、よく行くお店のメモです。どこかで遭遇したら飯でも奢ってやるよ。"
  >
    <PlacesSection
      sectionId="dart-spots-heading"
      title="よくいるダーツスポット"
      class="mb-10"
      areas={[
        {
          id: 'dart-spots',
          places: dartSpots,
        },
      ]}
    />

    <PlacesSection
      sectionId="food-shops-heading"
      title="よく行く飲食店"
      class="mt-4"
      areas={shopAreas}
    />
  </ListPageLayout>
</Layout>
