---
import { OldWatchAnimes } from '../anime-list/anime-list';
import ListPageLayout from '../components/ListPageLayout.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout 
  title="今まで視聴したアニメ、漫画一覧 - @tonosaki"
  description="今まで視聴したアニメ、漫画の一覧です。"
>
  <ListPageLayout
    title="今まで視聴したアニメ、漫画一覧"
    backHref="/"
    description="今まで視聴したアニメ、漫画の一覧です。"
  >
    <form id="anime-search-form" class="card mb-4 p-4 sm:p-5">
      <div class="flex items-baseline justify-between gap-3">
        <label class="text-sm text-muted" for="anime-search">
          アニメ、漫画名で検索
        </label>
        <p id="search-count" class="text-xs text-muted" aria-live="polite">{OldWatchAnimes.length}件</p>
      </div>
      <input
        id="anime-search"
        type="text"
        placeholder="タイトルを入力"
        class="mt-3 w-full rounded-xl border border-border bg-background px-3 py-2.5 text-sm text-foreground placeholder:text-subtle transition-colors focus:border-accent focus:outline-none"
      />
    </form>

    <p id="search-empty" class="mb-4 hidden text-sm text-muted">該当するタイトルがありません</p>

    <ul id="anime-list" class="card divide-y divide-border p-2">
      {OldWatchAnimes.map((anime) => (
        <li class="wrap-break-word rounded-xl px-3 py-2.5 text-foreground">
          {anime}
        </li>
      ))}
    </ul>
  </ListPageLayout>
</Layout>

<script>
  if (typeof window !== 'undefined') {
    const input = document.getElementById('anime-search');
    const list = document.getElementById('anime-list');
    const empty = document.getElementById('search-empty');
    const count = document.getElementById('search-count');

    // Enter で送信してページが再読み込みされないようにする（検索は input イベントで即時に行う）
    document.getElementById('anime-search-form')?.addEventListener('submit', (event) => {
      event.preventDefault();
    });

    if (input instanceof HTMLInputElement && list) {
      const items = Array.from(list.querySelectorAll('li'));

      input.addEventListener('input', () => {
        const query = input.value.trim().toLowerCase();
        let visible = 0;

        items.forEach((item) => {
          const text = item.textContent?.toLowerCase() ?? '';
          const match = text.includes(query);
          item.style.display = match ? '' : 'none';
          if (match) visible += 1;
        });

        if (count) {
          count.textContent = `${visible}件`;
        }
        if (empty) {
          empty.classList.toggle('hidden', visible !== 0);
        }
      });
    }
  }
</script>
