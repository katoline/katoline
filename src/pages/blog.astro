---
import Layout from '../layouts/Layout.astro';
import ListPageLayout from '../components/ListPageLayout.astro';
import { getPublishedPosts, type BlogEntry } from '../lib/blog';

const posts = await getPublishedPosts();
---

<Layout
  title="ブログ - @tonosaki"
  description="テック記事やアニメ感想を書いています。"
>
  <ListPageLayout
    title="ブログ"
    backHref="/"
  >
    {posts.length === 0 ? (
      <p class="text-sm text-muted">
        まだ記事がありません。
      </p>
    ) : (
      <ul class="grid gap-3">
        {posts.map((post: BlogEntry) => (
          <li>
            <a
              href={`/blog/${post.id}`}
              class="card group flex flex-col gap-2 p-5 text-foreground transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/50"
            >
              {post.data.date && (
                <p class="text-xs tracking-wide text-muted">
                  {post.data.date.toLocaleDateString('ja-JP', { timeZone: 'UTC' })}
                </p>
              )}
              <h2 class="text-lg font-bold leading-snug group-hover:text-accent">
                {post.data.title}
              </h2>
            </a>
          </li>
        ))}
      </ul>
    )}
  </ListPageLayout>
</Layout>
